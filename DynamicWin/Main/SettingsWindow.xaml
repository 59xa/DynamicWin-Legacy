<Window x:Class="DynamicWin.Main.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DynamicWin Settings"
        Width="550"
        Height="450"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E1E"
        ResizeMode="CanResizeWithGrip">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <TextBlock Grid.Row="0" Text="Settings will open as a separate window" 
                   Foreground="White" FontSize="18" 
                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
        
        <Button Grid.Row="1" Content="Close" Click="SaveAndClose_Click" 
                HorizontalAlignment="Center" Margin="10" Padding="20,10"/>
    </Grid>
</Window>