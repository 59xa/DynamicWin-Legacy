<Window x:Class="DynamicWin.Main.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DynamicWin Settings"
        Width="550"
        Height="550"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E1E"
        ResizeMode="CanResizeWithGrip">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="20">
            <StackPanel>
                <!-- General -->
                <TextBlock Text="General" Foreground="White" FontSize="18" FontWeight="Bold" Margin="0,0,0,15"/>
                
                <CheckBox x:Name="chkAlwaysTopmost" Content="Keep interface always topmost" Foreground="White" Margin="0,5"/>
                <CheckBox x:Name="chkAllowBlur" Content="Toggle blur" Foreground="White" Margin="0,5"/>
                <CheckBox x:Name="chkAllowAnimation" Content="Toggle animations" Foreground="White" Margin="0,5"/>
                <CheckBox x:Name="chkAntiAliasing" Content="Toggle anti-aliasing" Foreground="White" Margin="0,5"/>
                
                <!-- Display -->
                <TextBlock Text="Display" Foreground="White" FontSize="18" FontWeight="Bold" Margin="0,25,0,15"/>
                
                <CheckBox x:Name="chkToggleHighRefreshRate" Content="Toggle high refresh rate" Foreground="White" Margin="0,5"/>
                <CheckBox x:Name="chkLimitRefreshRateWhenIdle" Content="Limit refresh rate when idle" Foreground="White" Margin="0,5"/>
                
                <!-- Island -->
                <TextBlock Text="Island" Foreground="White" FontSize="18" FontWeight="Bold" Margin="0,25,0,15"/>
                
                <CheckBox x:Name="chkToggleIslandShadow" Content="Toggle island shadow" Foreground="White" Margin="0,5"/>
                <CheckBox x:Name="chkToggleHomeMenuShadow" Content="Toggle home menu shadow when idle" Foreground="White" Margin="0,5"/>
                
                <!-- Working Area -->
                <TextBlock Text="Working Area" Foreground="White" FontSize="18" FontWeight="Bold" Margin="0,25,0,15"/>
                
                <CheckBox x:Name="chkShortenWindowsWorkingArea" Content="Shorten for Island/Notch" Foreground="White" Margin="0,5"/>
                <TextBlock Text="Limits the space other windows have to exclude the island/notch" Foreground="#888888" FontSize="11" Margin="25,0,0,5" TextWrapping="Wrap"/>
                
                <!-- System -->
                <TextBlock Text="System" Foreground="White" FontSize="18" FontWeight="Bold" Margin="0,25,0,15"/>
                
                <CheckBox x:Name="chkRunOnStartup" Content="Start application on login" Foreground="White" Margin="0,5"/>
                <CheckBox x:Name="chkAllowAutomaticUpdates" Content="Allow automatic updates" Foreground="White" Margin="0,5"/>
                
                <!-- Monitor -->
                <TextBlock Text="Monitor" Foreground="White" FontSize="18" FontWeight="Bold" Margin="0,25,0,15"/>
                
                <ComboBox x:Name="cmbMonitor" Width="200" HorizontalAlignment="Left"/>
            </StackPanel>
        </ScrollViewer>
        
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="10">
            <Button Content="Save" Click="Save_Click" Padding="20,10" Margin="5"/>
            <Button Content="Cancel" Click="Cancel_Click" Padding="20,10" Margin="5"/>
        </StackPanel>
    </Grid>
</Window>